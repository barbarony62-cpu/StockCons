<Window x:Class="AskCons.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AskCons V0.1.5" WindowState="Maximized" MinWidth="900" MinHeight="620" Background="#F5F8FD" FontFamily="Segoe UI"><Grid><Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/><RowDefinition Height="120"/></Grid.RowDefinitions><Border Background="#0C3265" Padding="26"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/AskCons;component/AskCons.png" Width="58" Height="58"/><StackPanel Margin="16,0"><TextBlock Text="AskCons" FontSize="30" FontWeight="Bold" Foreground="White"/><TextBlock Text="Private financial questions • V0.1.5" Foreground="#CFE5FF"/></StackPanel></StackPanel></Border><Grid Grid.Row="1" Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,18,0"><StackPanel><TextBlock Text="ACCOUNT" FontWeight="Bold" Foreground="#173D70"/><ComboBox x:Name="AccountBox" Margin="0,10,0,24" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="AccountChanged"/><TextBlock Text="PREVIOUS QUESTIONS" FontWeight="Bold" Foreground="#173D70" Margin="0,4,0,8"/><ListBox x:Name="HistoryList" MinHeight="250" MaxHeight="550" SelectionChanged="HistorySelected" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4,8" ToolTip="Click to ask again"/></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="Test AI connection" Padding="8" Margin="0,12,0,0" Click="TestAiClick"/><TextBlock x:Name="AiStatus" Text="" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#173D70"/><TextBlock x:Name="DbStatus" Visibility="Collapsed"/></StackPanel></Border><Border Grid.Column="1" Background="White" CornerRadius="12" Padding="25"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Ask about your investments" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,14"/><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="AnswerText" FontSize="17" TextWrapping="Wrap" LineHeight="29" Text="Choose an account and ask a question.&#10;&#10;Examples:&#10;• How much has my account changed since January 1?&#10;• What was my account worth six months ago?&#10;• How has my Tesla holding value changed over six months?&#10;• כמה השתנה שווי החשבון שלי מתחילת השנה?&#10;&#10;Results use stored snapshots; they are not investment returns adjusted for cash flows."/></ScrollViewer></DockPanel></Border></Grid><Border Grid.Row="2" Background="White" Padding="24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBox x:Name="QuestionBox" FontSize="17" Padding="12" TextWrapping="Wrap" AcceptsReturn="True" ToolTip="Enter = Ask; Shift+Enter = new line" PreviewKeyDown="QuestionKeyDown"/><Button x:Name="AskButton" Grid.Column="1" Content="Ask →" Margin="14,0,0,0" FontSize="18" FontWeight="Bold" Foreground="White" Background="#0754A4" Click="AskClick"/></Grid></Border></Grid></Window>