<Window x:Class="AskCons.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AskCons V0.3.2" WindowState="Maximized" MinWidth="950" MinHeight="650" Background="#F5F8FD" FontFamily="Segoe UI">
<Grid>
 <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/><RowDefinition Height="112"/></Grid.RowDefinitions>
 <Border Grid.Row="0" Background="#0C3265" Padding="20,10"><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
   <Border Width="66" Height="66" Background="White" CornerRadius="10" Padding="0" ClipToBounds="False"><Image Source="/AskCons;component/AskCons.png" Stretch="Uniform" Width="62" Height="62" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <TextBlock Text="AskCons" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="White"/>
 </StackPanel></Border>
 <Grid Grid.Row="1" Margin="22,18,22,18"><Grid.ColumnDefinitions><ColumnDefinition Width="258"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,18,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="ACCOUNT" Foreground="#173D70" FontWeight="Bold"/>
   <ComboBox Grid.Row="1" x:Name="AccountBox" Margin="0,10,0,24" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="AccountChanged"/>
   <TextBlock Grid.Row="2" Text="PREVIOUS QUESTIONS" Foreground="#173D70" FontWeight="Bold" Margin="0,0,0,8"/>
   <ListBox Grid.Row="3" x:Name="HistoryList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="HistorySelected" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxHeight="75" Margin="3,8" ToolTip="{Binding}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
   <Button Grid.Row="4" Content="Test AI connection" Padding="8" Margin="0,14,0,0" Click="TestAiClick"/>
   <TextBlock Grid.Row="5" x:Name="AiStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#173D70"/>
  </Grid></Border>
  <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="AnswerHeading" Text="Ask about your investments" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Button x:Name="ShowDataButton" Grid.Column="1" Content="Show data table" Padding="12,6" Click="ToggleDataClick" Visibility="Collapsed"/>
   </Grid>
   <TextBlock Grid.Row="1" x:Name="AnswerSubtitle" Margin="0,8,0,16" Foreground="#62758B" FontSize="13" TextWrapping="Wrap"/>
   <Grid Grid.Row="2">
    <ScrollViewer x:Name="AnswerScroll" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="AnswerText" FontSize="17" TextWrapping="Wrap" LineHeight="28" Text="Choose an account and ask a question."/></ScrollViewer>
    <DataGrid x:Name="ResultsGrid" Visibility="Collapsed" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="37" FontSize="15" BorderThickness="0" AlternatingRowBackground="#F2F7FD" ColumnHeaderHeight="40" SelectionMode="Single" />
    <Grid x:Name="ChartHost" Visibility="Collapsed" Background="White" SizeChanged="ChartSizeChanged"><Canvas x:Name="PlotCanvas" ClipToBounds="True"/></Grid>
   </Grid>
   <TextBlock Grid.Row="3" x:Name="AnswerNote" Margin="0,12,0,0" Foreground="#62758B" FontSize="12" TextWrapping="Wrap"/>
  </Grid></Border>
 </Grid>
 <Border Grid.Row="2" Background="White" Padding="22,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,0,0,7"><TextBlock Text="Display:" VerticalAlignment="Center" Foreground="#425773" Margin="0,0,8,0"/><ComboBox x:Name="DisplayModeBox" Width="140" SelectionChanged="DisplayModeChanged"><ComboBoxItem Content="Automatic" IsSelected="True"/><ComboBoxItem Content="Table"/><ComboBoxItem Content="Graph"/><ComboBoxItem Content="Text"/></ComboBox></StackPanel>
  <TextBox Grid.Row="1" x:Name="QuestionBox" FontSize="16" Padding="10" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" ToolTip="Enter = Ask; Shift+Enter = new line" PreviewKeyDown="QuestionKeyDown"/>
  <Button Grid.Row="1" Grid.Column="1" x:Name="AskButton" Content="Ask →" Margin="14,0,0,0" FontSize="18" FontWeight="Bold" Foreground="White" Background="#0754A4" Click="AskClick"/>
 </Grid></Border>
</Grid></Window>